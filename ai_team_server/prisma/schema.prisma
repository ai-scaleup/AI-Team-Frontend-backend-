// ─────────────────────────────────────────────────────────────
// User Preference Enums (Italian)
// ─────────────────────────────────────────────────────────────
enum ContentLanguage {
  ITALIANO
  INGLESE
  SPAGNOLO
  FRANCESE
  TEDESCO
  PORTOGHESE
  ALTRO
}

enum ToneOfVoice {
  PROFESSIONALE_FORMALE
  AMICHEVOLE_INFORMALE
  TECNICO_ESPERTO
  MOTIVAZIONALE_ENERGETICO
  EMPATICO_COMPRENSIVO
  INNOVATIVO_VISIONARIO
  DIVERTENTE_CREATIVO
}

enum MarketingKnowledge {
  BASE
  INTERMEDIO
  AVANZATO
  EXPERT
}

enum ResponseLength {
  CONCISA
  BILANCIATA
  DETTAGLIATA
}

enum EmojiUsage {
  MAI
  MINIMO
  MODERATO
  FREQUENTE
}

enum ProactivityLevel {
  SOLO_REATTIVO
  MODERATAMENTE_PROATTIVO
  MOLTO_PROATTIVO
}

enum QuestionStyle {
  UNA_ALLA_VOLTA
  A_GRUPPI
  MINIMO_INDISPENSABILE
}

enum DecisionHelpStyle {
  ANALISI_OPZIONI
  RACCOMANDAZIONE_DIRETTA
  ENTRAMBI
}

enum LearningPreference {
  APPRENDIMENTO_CONTINUO
  COMPORTAMENTO_STATICO
  AGGIORNAMENTI_PERIODICI
}

enum MarketComparison {
  SEMPRE
  SOLO_RILEVANTI
  MAI
}

enum TokenAlertLevel {
  INFO
  WARNING
  CRITICAL
}

enum TokenAlertScope {
  CONVERSATION
  MONTHLY
}

// Chat completion model the platform calls. OpenAI only for now; other
// providers get appended here later -- values are only ever added, never
// removed, so stored rows stay readable.
enum ApiModel {
  GPT_5
  GPT_5_MINI
  GPT_5_NANO
  GPT_4_1
  GPT_4_1_MINI
  GPT_4O
  GPT_4O_MINI
  O3
  O4_MINI
}

model User {
  id            String                @id @default(uuid())
  email         String                @unique
  oauthId       String                @unique
  username      String?
  // Token allowance stamped onto every conversation this user creates from now
  // on. Null means no quota. Kept on the user rather than derived from the
  // conversations so a limit assigned before the first chat still survives.
  tokenLimit    Int?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  // Per-agent assignments with timing & expiry
  agents        SingleAssignedAgent[]
  // Team-level assignments (AgentTeam), independent of the tiers above/below
  teams         AssignedTeam[]
  // User conversations
  conversations Conversation[]
  // User preferences (one-to-many: per agent)
  preferences   UserPreference[]
  // Token usage per agent
  tokenUsage    UserAgentTokenUsage[]
  // Memberships
  memberships   AssignedMembership[]
  // Daily Usage Tracking
  dailyUsage    DailyTokenUsage[]
  // Daily team / single-agent spend, for charts only
  grantDailyUsage GrantTokenUsageDaily[]
  // Token Quota Stops
  stopLogs      TokenLimitStopLog[]
  // UI Alerts
  alerts        UserAlert[]
}

// Pearl white-label data is isolated from the application's existing User
// model. The mapped database names retain the requested prefix.
model PearlWhitelabelUser {
  id        String   @id @default(uuid())
  email     String   @unique
  oauthId   String   @unique
  username  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userData PearlWhitelabelUserData[]

  @@map("pearl_whitelabel_User")
}

model PearlWhitelabelUserData {
  id           String              @id @default(uuid())
  campaignName String
  outboundId   String
  bearerToken  String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  userId       String
  user         PearlWhitelabelUser @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId])
  @@map("pearl_whitelabel_UserData")
}

// ─────────────────────────────────────────────────────────────
// User Preferences Model (Per User + Agent combination)
// ─────────────────────────────────────────────────────────────
model UserPreference {
  id                  String             @id @default(uuid())
  oauthId             String // User's OAuth ID
  email               String // User's email, denormalized for lookup/display
  agentName           AgentName // Each agent has its own preferences per user
  // ── SECTION: IDENTITY ──
  displayName         String? // What user wants to be called
  businessName        String? // Name of user's business
  // ── SECTION: TONGUE (Language) ──
  contentLanguage     ContentLanguage    @default(ITALIANO) // Language for AI-generated content
  responseLanguage    ContentLanguage    @default(ITALIANO) // Language for AI responses
  // ── SECTION: BRAND STYLE ──
  toneOfVoice         ToneOfVoice        @default(PROFESSIONALE_FORMALE)
  marketingKnowledge  MarketingKnowledge @default(INTERMEDIO)
  // ── SECTION: INTERACTION ──
  responseLength      ResponseLength     @default(BILANCIATA)
  emojiUsage          EmojiUsage         @default(MINIMO)
  // ── SECTION: AI BEHAVIOR ──
  proactivityLevel    ProactivityLevel   @default(MODERATAMENTE_PROATTIVO)
  questionStyle       QuestionStyle      @default(UNA_ALLA_VOLTA)
  decisionHelpStyle   DecisionHelpStyle  @default(ENTRAMBI)
  // ── SECTION: PERSONALIZATION ──
  learningPreference  LearningPreference @default(APPRENDIMENTO_CONTINUO)
  marketComparison    MarketComparison   @default(SOLO_RILEVANTI)
  // ── ONBOARDING STATUS ──
  onboardingCompleted Boolean            @default(false)
  onboardingStep      Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  user                User               @relation(fields: [oauthId], references: [oauthId], onDelete: Cascade)

  @@unique([oauthId, agentName], map: "uniq_preference_per_user_agent")
  @@index([oauthId])
  @@index([email])
  @@index([agentName])
}

model SingleAssignedAgent {
  id           String    @id @default(uuid())
  userId       String
  agentName    AgentName
  startsAt     DateTime  @default(now())
  expiresAt    DateTime?
  durationDays Int?
  isActive     Boolean   @default(true)

  // Token allowance carried by this direct grant. Null means the grant confers
  // access only.
  // Only the direct assign path ever writes this.
  tokenLimit Int?

  // Running totals for this grant, so the agent tier can be read without
  // joining UserAgentTokenUsage. DailyTokenUsage stays the source of truth
  // for cycle maths -- these are a rollup, not the ledger.
  usedTokens   Int  @default(0)
  inputTokens  Int  @default(0)
  outputTokens Int  @default(0)
  tokensLeft   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Allowed multiples just in case, or we keep unique
  @@index([userId, isActive])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────
// Agent Teams (team-level assignment tier)
//
// A separate tier from SingleAssignedAgent and from the membership tables.
// Nothing here reads or writes those tables. Memberships may bundle a team
// (MembershipTemplateTeam) but only read it — they never write this tier.
// ─────────────────────────────────────────────────────────────
model AgentTeam {
  id          String  @id @default(uuid())
  name        String  @unique
  description String
  isActive    Boolean @default(true)

  // Default PER-AGENT token allowance for the team. When the team is
  // assigned to a user, every agent in the team gets this much on its own
  // AssignedTeamAgent row (the AssignedTeam grant records it as its
  // per-agent tokenLimit); null = access only. Only the team CRUD path
  // writes this.
  tokenLimit Int?

  agents              AgentTeamAgent[]
  assignments         AssignedTeam[]
  // Memberships that bundle this team (read-only from the membership side).
  membershipTemplates MembershipTemplateTeam[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@index([isActive])
}

model AgentTeamAgent {
  id        String    @id @default(uuid())
  teamId    String
  agentName AgentName
  createdAt DateTime  @default(now())
  team      AgentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, agentName], map: "uniq_agent_per_team")
  @@index([teamId])
}

model AssignedTeam {
  id           String    @id @default(uuid())
  userId       String
  teamId       String
  startsAt     DateTime  @default(now())
  expiresAt    DateTime?
  durationDays Int?
  isActive     Boolean   @default(true)

  // PER-AGENT allowance: every agent in the team gets this many tokens on
  // its own AssignedTeamAgent row -- it is not a pool shared by the team.
  // Seeded from AgentTeam.tokenLimit at assignment time unless the admin
  // overrides it. Null = access only.
  tokenLimit Int?

  // Rollup of spend across the team's agents for this grant: the sums of
  // the AssignedTeamAgent rows below. tokensLeft is the sum of what each
  // agent still has, so it can reach tokenLimit * agentCount.
  usedTokens   Int  @default(0)
  inputTokens  Int  @default(0)
  outputTokens Int  @default(0)
  tokensLeft   Int?

  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      AgentTeam           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  // One row per agent in the team, kept in step with AgentTeamAgent when
  // the roster changes.
  agents    AssignedTeamAgent[]

  @@index([userId, isActive])
  @@index([teamId])
  @@index([expiresAt])
}

// Per-agent slice of a team grant. This is where the team tier's allowance
// actually lives: each agent in the team draws on its own tokenLimit and the
// parent AssignedTeam only carries the sums. Limits are written by the team
// assignment path; usage by the token ledger (TokenUsageService).
model AssignedTeamAgent {
  id             String    @id @default(uuid())
  assignedTeamId String
  agentName      AgentName

  // Allowance for this one agent under this grant. Null = access only.
  tokenLimit Int?

  usedTokens   Int  @default(0)
  inputTokens  Int  @default(0)
  outputTokens Int  @default(0)
  tokensLeft   Int?

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  grant     AssignedTeam @relation(fields: [assignedTeamId], references: [id], onDelete: Cascade)

  @@unique([assignedTeamId, agentName], map: "uniq_agent_per_assigned_team")
  @@index([assignedTeamId])
  @@index([agentName])
}

// ─────────────────────────────────────────────────────────────
// Conversation & Message Models
// ─────────────────────────────────────────────────────────────
model Conversation {
  id          String    @id
  userId      String
  email       String?
  title       String
  agentId     String
  sessionId   String
  folderId    String?
  tokenLimit  Int?
  tokenUsed   Int?
  tokenLeft   Int?
  archived    Boolean   @default(false)
  lastUpdated DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  messages    Message[]
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([agentId])
  @@index([archived])
  @@index([lastUpdated])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  text           String
  sender         String
  time           String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

