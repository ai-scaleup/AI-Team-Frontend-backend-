# Runtime
PORT=8000
NODE_ENV=development

# PostgreSQL / Prisma
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DB_POOL_MAX=1

# Authentication
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Optional test-token authentication. If omitted, this test platform uses the
# built-in development token. Never use that fallback with production data.
DEV_API_TOKEN=

# AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Pearl Admin integration
ADMIN_API_KEY=
PEARL_ADMIN_API_URL=

# Optional comma-separated frontend origins. Leave empty to allow all origins
# for a test deployment, or set deployed frontend URLs for stricter CORS.
CORS_ORIGINS=

# Admin accounts that may chat with every agent regardless of assignment.
# Comma-separated; leave empty to use the built-in list (src/common/admin-emails.ts).
ADMIN_EMAILS=

# n8n agent webhooks, read by src/agent-chat (POST /agents/:slug/chat).
# Names match the former AI-Team-frontend/.env.example one to one.
# N8N_SHARED_SECRET is sent as X-Agent-Secret; set the same value as a Header
# Auth credential on every n8n Webhook node so direct calls are rejected.
N8N_SHARED_SECRET=
ALADINO_AI_N8N_ENDPOINT=
ALEX_AI_N8N_ENDPOINT=
DAN_AI_N8N_ENDPOINT=
DANIELE_AI_N8N_ENDPOINT=
JIM_AI_N8N_ENDPOINT=
LARA_AI_N8N_ENDPOINT=
LAURA_AI_N8N_ENDPOINT=
MAX_AI_N8N_ENDPOINT=
MIKE_AI_N8N_ENDPOINT=
NIKO_AI_N8N_ENDPOINT=
ROBERTA_AI_N8N_ENDPOINT=
SARA_AI_N8N_ENDPOINT=
SIMONE_AI_N8N_ENDPOINT=
SOFIA_AI_N8N_ENDPOINT=
TONY_AI_N8N_ENDPOINT=
VALENTINA_AI_N8N_ENDPOINT=
TEST_ALADINO_AI_N8N_ENDPOINT=
TEST_ALEX_AI_N8N_ENDPOINT=
TEST_DANIELE_AI_N8N_ENDPOINT=
TEST_JIM_AI_N8N_ENDPOINT=
TEST_LARA_AI_N8N_ENDPOINT=
TEST_MIKE_AI_N8N_ENDPOINT=
TEST_NIKO_AI_N8N_ENDPOINT=
TEST_SIMONE_AI_N8N_ENDPOINT=
TEST_TONY_AI_N8N_ENDPOINT=
TEST_VALENTINA_AI_N8N_ENDPOINT=
TEST_VALENTINA_AI_HISTORY_N8N_ENDPOINT=
GIULIA_WIDGET_N8N_ENDPOINT=
JENNIFER_WIDGET_N8N_ENDPOINT=
